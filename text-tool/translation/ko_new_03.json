{
  "asset_448:004E72": "코넬:\n!!",
  "asset_448:004E8C": "오르테가:\n한,",
  "asset_448:004EA4": "참,",
  "asset_448:004EAA": "기다렸다고,",
  "asset_448:004EB2": "코넬.\n나와 싸우기도 전에\n당해 버린 줄 알았잖아.",
  "asset_448:004EF2": "코넬:\n...에이다는... 어디 있지...",
  "asset_448:004F28": "오르테가:\n...넌 예전부터\n약속은 지키는 놈이었지.\n반드시 올 줄 알았다.",
  "asset_448:004F84": "이제야\n너와 결판을 낼 수 있겠군.",
  "asset_448:004FBA": "오르테가:\n머, 머리가... 깨질 것 같아...\n힘을... 억누를 수가...",
  "asset_448:00500C": "코넬:\n...오르테가?",
  "asset_448:005030": "오르테가:\n...그래, 넌 언제나\n나보다 한발 앞서 있었지...",
  "asset_448:00507C": "수인족 중에서\n유일하게 봉인을 다루는 넌...",
  "asset_448:0050AA": "1년 전, 주먹을 맞댔을 때...\n네 눈은 달처럼 차가웠어...",
  "asset_448:0050FE": "약자를 바라보는 눈이었지...\n날 진심으로\n상대하지 않았어...",
  "asset_448:00514C": "하지만 지금은 달라...\n그때와는,",
  "asset_448:005174": "다르다고오오!!!",
  "asset_448:005192": "하아, 하아...",
  "asset_448:0051A8": "코넬,",
  "asset_448:0051B4": "에이다가 그렇게 걱정되나?",
  "asset_448:0051FA": "오르테가:\n왜 그렇게까지 하지?",
  "asset_448:00521C": "너와 에이다는\n피 한 방울 섞이지 않은\n남남이잖아?",
  "asset_448:00525E": "코넬:\n...너와는 상관없다...",
  "asset_448:00528E": "오르테가:\n...뭐, 됐다. 지금쯤\n제물 의식이 시작됐겠군.",
  "asset_448:0052DC": "코넬:\n뭐라고!?",
  "asset_448:0052FA": "오르테가:\n지금 가면 늦지 않을 텐데,\n코넬...?",
  "asset_448:00533A": "물론 그전에\n나와의 볼일을\n끝내야겠지만 말이야!!",
  "asset_448:00537C": "코넬:\n네놈... 용서 못 한다!!",
  "asset_448:0053AA": "오르테가:\n좋아, 이제야 진심으로\n싸울 마음이 들었나, 코넬!",
  "asset_448:0053F2": "그런데...\n이걸로 끝인 줄 아느냐?",
  "asset_448:005414": "하하하핫, 기쁘구나아!!",
  "asset_448:005436": "이이제야아...\n진시임으...로오...\n싸아울 수우... 있겠구나아...",
  "asset_448:00548C": "오르테가:\n코오오오...\n네에에에엘...!!!",
  "asset_449:004662": "오르테가:\n하하...\n역시 네겐 못 이기겠군,\n코넬.",
  "asset_449:0046A8": "드라큘라의 마력으로도\n널 넘을 수 없었나...",
  "asset_449:0046E4": "코넬:\n오르테가...",
  "asset_449:004708": "오르테가:\n...에이다는 시계탑에 숨겼다...\n아직 제물로 바치진 않았어...",
  "asset_449:00476E": "코넬:\n정말이냐, 오르테가?!",
  "asset_449:004806": "...그러니 후회는 없어...\n거짓 없는 네 주먹을... 느꼈다...",
  "asset_449:00485C": "...다만 마을 사람들에겐...\n몹쓸 짓을 저질렀어...\n돌이킬 수 없는 짓을...",
  "asset_449:0048C0": "코넬:\n오르테가, 이제 됐어.",
  "asset_449:0048E8": "오르테가:\n부디... 그 아이를...",
  "asset_449:00490C": "...구해 다오... 에이다를...",
  "asset_449:00493C": "코넬:\n그래...",
  "asset_449:00495C": "오르테가:\n...떨어져라, 코넬...\n히, 힘이... 폭주한다...\n나도 멈출 수가 없어...",
  "asset_449:0049C8": "코넬:\n오르테가!!",
  "asset_449:0049EA": "코넬:\n오르테가아!!",
  "asset_450:002742": "코넬:\n...!!",
  "asset_450:00275A": "에이다, 에이다...!",
  "asset_450:00277C": "에이다:\n코넬 오빠...\n마을이 불타고... 모두가...",
  "asset_450:0027C6": "코넬:\n...이제 괜찮다.",
  "asset_450:0027F0": "코넬:\n크윽!! 에이다!",
  "asset_450:002818": "에이다:\n코넬 오빠, 살려 줘!",
  "asset_450:002844": "사신:\n드디어 찾았군.\n제물을 이런 곳에\n숨겨 두다니...",
  "asset_450:002896": "성스러운 제물 의식이\n어그러질 뻔했지 않으냐.",
  "asset_450:0028D8": "그 라이칸스로프 놈,\n쓸모는 있을 줄 알았거늘...",
  "asset_450:002918": "백작님의 명을 거역해\n스스로 목숨을 줄이다니...\n어리석은 놈.",
  "asset_450:002966": "코넬:\n멈춰라!",
  "asset_450:00297C": "젠장, 에이다...!\n기다려라, 꼭 구해 주마!",
  "asset_451:0036C2": "코넬:\n...에이다!!\n",
  "asset_451:0036EA": "에이다:\n....!\n......!!",
  "asset_451:00371A": "목소리:\n하하하하하하하하...",
  "asset_451:00374C": "마왕 드라큘라 백작:\n용케도\n마왕 앞까지 왔구나.",
  "asset_451:00378A": "칭찬해 주마...",
  "asset_451:0037B0": "코넬:\n네, 네놈이...\n드라큘라 백작이냐...!!",
  "asset_451:0037F2": "코넬:\n내 동생을...\n에이다를 돌려줘!!",
  "asset_451:003828": "마왕 드라큘라 백작:\n흐흐흐,",
  "asset_451:003848": "아름다운 남매의 정이로다.\n참으로 기특하구나...",
  "asset_451:00387A": "마왕 드라큘라 백작:\n네 투지가 보인다...",
  "asset_451:0038AA": "과연, 기대할 만하겠구나.",
  "asset_451:0038D4": "마왕 드라큘라 백작:\n늑대인간이여,",
  "asset_451:0038F4": "네 힘을 한계까지 끌어내라!!",
  "asset_451:003918": "동생을 구하고 싶거든\n온 힘을 다해 덤비거라!!",
  "asset_451:003958": "살아 있는 모든 것들이여,\n달콤한 어둠의 심연으로!!\n내 생명의 양식이 되어라!!!",
  "asset_452:004622": "코넬:\n에이다!!",
  "asset_452:004642": "마왕 드라큘라 백작:\n흐흐흐흐흐,",
  "asset_452:004668": "하하하하하하하하하...!!",
  "asset_452:004690": "...참으로 한심하구나.",
  "asset_452:0046AE": "네 힘이 고작\n그 정도일 리는 없겠지!!",
  "asset_452:0046E2": "...나는 알고 있다.",
  "asset_452:0046FC": "푸른 늑대인간이여...",
  "asset_452:004712": "그 여자는 늑대인간이 아니다.",
  "asset_452:00472C": "너희 수인들이 멸한 인간들의\n생존자가 아니더냐...",
  "asset_452:00476A": "코넬:\n그만해!!",
  "asset_452:004782": "말하지 마!!",
  "asset_452:004796": "마왕 드라큘라 백작:\n어릴 적부터 늑대인간의\n자식으로 키웠겠지만,",
  "asset_452:0047DE": "내 눈은 속일 수 없느니라...",
  "asset_452:004802": "그렇게까지 애써\n이 여자를 구하려는 것은\n속죄하려는 심산이더냐?",
  "asset_452:00484A": "아니면 스스로\n면죄부를 얻을 줄 알았느냐?",
  "asset_452:004882": "네가 그런 짓을 하면\n이 여자가 기뻐할 줄 알았느냐?",
  "asset_452:0048BC": "어리석은 수인의\n기만일 뿐이로다!!",
  "asset_452:0048FE": "하하하하하하하....!!",
  "asset_452:00491A": "그렇다면 진심으로\n싸울 수 있게 해 주마!!",
  "asset_452:00494E": "코넬:\n에이다아!!",
  "asset_452:004970": "마왕 드라큘라 백작:\n진정한 내 모습을 보아라...\n절대무비한 내 힘을!!",
  "asset_452:0049C2": "그 여자를 구하고 싶거든\n목숨을 걸고 덤비거라!!",
  "asset_454:000F32": "여자:\n이렇게 마주 서 있는 것만으로\n소름 끼칠 만큼 강한 마력이\n느껴지는군...",
  "asset_454:001002": "여자:\n우후후후.",
  "asset_454:00104C": "마녀 악트리세:\n위대한 마왕,\n드라큘라 백작을 부활시킨 건\n우리야.",
  "asset_454:0010CA": "마녀 악트리세:\n마왕의 완전한 부활을 위해\n네 힘을 갖고 싶어...",
  "asset_455:00136C": "마녀 악트리세:\n우후후후,",
  "asset_455:00138E": "자, 그때 물었던 답을\n들려주겠니...?",
  "asset_455:0013C6": "...그렇지만,",
  "asset_455:0013DA": "그 건방진 얼굴을 보니\n어떤 대답인지 알겠구나...",
  "asset_455:00147E": "마녀 악트리세:\n기세가 대단하구나, 꼬마야.",
  "asset_455:0014B0": "하지만 네 상대는\n내가 아니야. 우후후...",
  "asset_455:00152C": "마녀 악트리세:\n한때 마왕에게 맞섰던\n페르난데스의 전사지...",
  "asset_455:0015E6": "마녀 악트리세:\n처음엔 놀라운 정신력으로\n'저주'에 저항하더니,",
  "asset_455:0016A4": "오호호호호홋!",
  "asset_457:001282": "마녀 악트리세:\n솔직히 놀랐어.",
  "asset_457:0012F6": "마녀 악트리세:\n지금이라도 늦지 않았어.",
  "asset_457:001554": "마녀 악트리세:\n불쾌하군...",
  "asset_469:000690": "평화롭던 그 시절, 앞으로도",
  "asset_469:0006AE": "불안한 날은 없으리라, 모두가",
  "asset_469:0006CE": "믿어 의심치 않았다...",
  "asset_469:0006EA": "19세기 중엽, 트란실바니아,",
  "asset_469:00070C": "왈라키아 지방...",
  "asset_469:000720": "수많은 마왕 전설을 낳은",
  "asset_469:00073C": "이 땅에 다시 칠흑 같은 어둠이",
  "asset_469:00075E": "다가오고 있었다.",
  "asset_469:00076C": "타락한 영혼들이 사악한 자를",
  "asset_469:00078E": "100년간의 봉인된 잠에서",
  "asset_469:0007AC": "깨우고 말았던 것이다.",
  "asset_469:0007CC": "악마성의 주인이자 사악한 신,",
  "asset_469:0007E4": "'드라큘라 백작'의",
  "asset_469:0007FA": "부활이었다...",
  "asset_469:000830": "벨몬드의 피를 이은 정통",
  "asset_469:000852": "뱀파이어 킬러.",
  "asset_469:000866": "피의 숙명에 따라 대대로 전해진",
  "asset_469:000888": "성스러운 채찍을 들고 백작을",
  "asset_469:0008AA": "물리치기 위해 나섰다.",
  "asset_469:0008BA": "이제 젊은 사냥꾼의 싸움이",
  "asset_469:0008DE": "천둥소리와 함께 시작된다!!",
  "asset_469:000918": "남몰래 피를 이어 온",
  "asset_469:000934": "마도 일족, 페르난데스의 소녀.",
  "asset_469:000956": "마왕의 부활을 느낀 캐리는",
  "asset_469:000978": "드라큘라 백작을 봉인하려고",
  "asset_469:00099A": "홀로 악마성으로 향한다...",
  "asset_469:0009BC": "일족의 힘, '퇴마의 힘'을",
  "asset_469:0009DE": "휘두를 때가 온 것이다...",
  "asset_469:0009EE": "1852년...",
  "asset_469:000A42": "두 전사가 드라큘라 백작과",
  "asset_469:000A62": "사투를 벌이는 한편,",
  "asset_469:000A82": "동방 정교회는 악마성에 잡혀간",
  "asset_469:000AA4": "아이들의 구출 작전을 개시했다!",
  "asset_469:000AC4": "용감한 젊은 병사의 이름은",
  "asset_469:000AE6": "헨리.",
  "asset_469:000AF2": "그는 과연 7일 안에",
  "asset_469:000B14": "아이 6명을 모두 구해 낼 수",
  "asset_469:000B36": "있을 것인가?",
  "asset_470:000754": "갑자기 무서운 굉음이 울리며",
  "asset_470:000776": "악마성이 무너지기 시작했다!!",
  "asset_470:000792": "헨리는 무너지는 악마성에서",
  "asset_470:0007B6": "간신히 빠져나왔다...",
  "asset_470:0007CE": "눈부신 햇살 속, 호수에 가라앉는",
  "asset_470:0007EE": "악마성의 모습은 빛과 어둠의",
  "asset_470:000810": "싸움이 끝났음을 알렸다.",
  "asset_470:000832": "헨리의 활약 덕분에",
  "asset_470:00084E": "붙잡혀 갔던 아이 6명이 모두",
  "asset_470:000870": "무사히 구출되었다.",
  "asset_470:000886": "헨리:",
  "asset_470:000892": "'모두 무사해서 다행이야...",
  "asset_470:0008AE": "자, 다 같이 마을로 돌아가자!",
  "asset_470:0008C8": "아버지, 어머니가 기다리셔!'",
  "asset_470:0008EA": "아침 햇살이 비친 헨리의 얼굴에",
  "asset_470:00090A": "강인함과 다정함이 깃든",
  "asset_470:00092A": "미소가 떠올랐다.",
  "asset_470:000942": "젊은 헨리의 활약 덕분에",
  "asset_470:000960": "붙잡혀 간 아이 1명이",
  "asset_470:00097C": "무사히 구출되었다...",
  "asset_470:000992": "헨리:",
  "asset_470:00099E": "'...하지만,",
  "asset_470:0009B0": "아이들을 모두 구한 것은",
  "asset_470:0009D2": "아니야...'",
  "asset_470:0009E8": "헨리의 얼굴은",
  "asset_470:0009F8": "괴로움과 슬픔이 서린",
  "asset_470:000A14": "병사의 표정으로 바뀌었다.",
  "asset_470:000A32": "붙잡혀 간 아이 2명이,",
  "asset_470:000A52": "붙잡혀 간 아이 3명이,",
  "asset_470:000A72": "붙잡혀 간 아이 4명이,",
  "asset_470:000A92": "붙잡혀 간 아이 5명이,",
  "asset_470:000AB2": "헨리는 필사적으로 찾았지만,",
  "asset_470:000AD4": "붙잡혀 간 아이들은 단 한 명도",
  "asset_470:000AF6": "돌아오지 못했다...",
  "asset_470:000B18": "헨리:",
  "asset_470:000B24": "'아무도 구하지 못하다니...",
  "asset_470:000B38": "내가...",
  "asset_470:000B52": "너무 미숙한 탓에...'",
  "asset_470:000B6E": "미숙한 자신을 자책하는 헨리를",
  "asset_470:000B8E": "아침 햇살이 비추고 있었다...",
  "asset_471:000500": "푸른 초승달, 코넬",
  "asset_471:000516": "태고의 주술로 맹수를 능가할",
  "asset_471:00053A": "힘과 불사에 가까운 육체를",
  "asset_471:000558": "손에 넣은 수인족 전사.",
  "asset_471:000572": "인간과의 공존을 택한 수인들은",
  "asset_471:000592": "스스로 강대한 힘을 봉인했으나,",
  "asset_471:0005B2": "코넬은 혹독한 수련으로",
  "asset_471:0005D2": "봉인된 늑대인간의 힘을 푸는",
  "asset_471:0005F4": "방법을 터득했다.",
  "asset_471:000600": "수련 여행을 떠난 지 1년,",
  "asset_471:00061A": "코넬이 고향으로 돌아왔을 때,",
  "asset_471:00063E": "마을은 이미 괴물이 지른",
  "asset_471:00065E": "새빨간 화염에 휩싸여 있었다.",
  "asset_471:000678": "괴물에게 끌려간 유일한 혈육,",
